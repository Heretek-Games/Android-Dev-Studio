  "dialogues": {
    "DungeonKeeper": {
      "id": "DungeonKeeper",
      "startNodeId": "greet",
      "nodes": {
        "greet": {
          "id": "greet",
          "type": "choice",
          "speaker": "Dungeon Keeper",
          "text": "Tired bones in my halls again... Will you accept the blessing of the deep waters, Adventurer?",
          "choices": [
            {
              "id": "accept",
              "text": "Yes, Keeper. Grant me the Hydro blessing.",
              "nextNodeId": "blessed"
            },
            {
              "id": "decline",
              "text": "Not now, Keeper.",
              "nextNodeId": "farewell"
            }
          ]
        },
        "blessed": {
          "id": "blessed",
          "type": "action",
          "action": {
            "setVariables": {
              "hydroBlessing": true
            },
            "emitEvent": {
              "eventName": "hydro_blessing"
            }
          },
          "nextNodeId": "blessingFlows"
        },
        "blessingFlows": {
          "id": "blessingFlows",
          "type": "text",
          "speaker": "Dungeon Keeper",
          "text": "Then let the current run through your blade. Wash the ember spawn from my halls.",
          "nextNodeId": "farewell"
        },
        "farewell": {
          "id": "farewell",
          "type": "end"
        }
      }
    }

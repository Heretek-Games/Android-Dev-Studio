  "dialogues": {
    "DungeonKeeper": {
      "id": "DungeonKeeper",
      "startNodeId": "greet",
      "nodes": {
        "greet": {
          "id": "greet",
          "type": "choice",
          "speaker": "Dungeon Keeper",
          "text": "Kneel, wanderer. The deep waters remember those who ask politely. Do you seek my blessing?",
          "choices": [
            {
              "id": "accept",
              "text": "Yes, Keeper, bless me.",
              "nextNodeId": "blessed"
            },
            {
              "id": "decline",
              "text": "Not now.",
              "nextNodeId": "farewell"
            }
          ]
        },
        "blessed": {
          "id": "blessed",
          "type": "action",
          "speaker": "Dungeon Keeper",
          "text": "Then drink of the hydro light.",
          "action": {
            "setVariables": {
              "hydroBlessing": true
            },
            "event": "hydro_blessing",
            "fireEvent": "hydro_blessing"
          },
          "nextNodeId": "offer"
        },
        "offer": {
          "id": "offer",
          "type": "choice",
          "speaker": "Dungeon Keeper",
          "text": "Two wraiths haunt this hall. Take the blessing and clear them, or walk away unfavored.",
          "choices": [
            {
              "id": "take",
              "text": "I take the blessing and will clear the hall.",
              "nextNodeId": "thanks"
            },
            {
              "id": "refuse",
              "text": "I'll leave them be.",
              "nextNodeId": "farewell"
            }
          ]
        },
        "thanks": {
          "id": "thanks",
          "type": "action",
          "speaker": "Dungeon Keeper",
          "text": "Go then. The hall answers to the blessed.",
          "action": {
            "setVariables": {
              "blessingTaken": true
            },
            "event": "keeper_thanks",
            "fireEvent": "keeper_thanks"
          },
          "nextNodeId": "farewell"
        },
        "farewell": {
          "id": "farewell",
          "type": "end",
          "speaker": "Dungeon Keeper",
          "text": "The waters watch you."
        }
      }
    }
  }

{
  "name": "DrivingCourse",
  "goal": "Urban driving: the vehicle accelerates down the course, holds speed, and stays grounded within the mobile draw budget",
  "gameObjects": [
    { "name": "Ground", "shape": "box", "size": [300, 1, 300], "position": [0, -0.5, 0], "color": "#27272a", "physics": "fixed" },
    {
      "name": "Chassis",
      "shape": "box",
      "size": [2, 0.6, 4],
      "position": [0, 1, 0],
      "color": "#ef4444",
      "physics": "dynamic",
      "mass": 800,
      "vehicle": {
        "engineForce": 3000,
        "brakeForce": 40,
        "maxSteerAngle": 0.5,
        "throttle": 1,
        "steering": 0,
        "brake": 0,
        "wheels": [
          { "name": "FL", "offset": [-0.9, -0.3, -1.3], "radius": 0.35, "steered": true },
          { "name": "FR", "offset": [0.9, -0.3, -1.3], "radius": 0.35, "steered": true },
          { "name": "RL", "offset": [-0.9, -0.3, 1.3], "radius": 0.35, "driven": true },
          { "name": "RR", "offset": [0.9, -0.3, 1.3], "radius": 0.35, "driven": true }
        ]
      }
    },
    { "name": "Pillar West 1", "shape": "box", "size": [1.5, 4, 1.5], "position": [-6, 2, -30], "color": "#f472b6", "physics": "fixed" },
    { "name": "Pillar East 1", "shape": "box", "size": [1.5, 4, 1.5], "position": [6, 2, -30], "color": "#f472b6", "physics": "fixed" },
    { "name": "Pillar West 2", "shape": "box", "size": [1.5, 4, 1.5], "position": [-6, 2, -60], "color": "#fb923c", "physics": "fixed" },
    { "name": "Pillar East 2", "shape": "box", "size": [1.5, 4, 1.5], "position": [6, 2, -60], "color": "#fb923c", "physics": "fixed" },
    { "kind": "light", "name": "City Sun", "lightType": "directional", "color": "#ffffff", "intensity": 2.2, "position": [10, 20, 10] }
  ],
  "rules": [
    { "id": "vehicle_exists", "type": "entity_exists", "target": "Chassis" },
    { "id": "vehicle_has_controller", "type": "entity_component", "target": "Chassis", "component": "VehicleController" },
    { "id": "vehicle_drives_distance", "type": "distance_traveled", "target": "Chassis", "min": 20 },
    { "id": "vehicle_holds_speed", "type": "speed_min", "target": "Chassis", "min": 5 },
    { "id": "vehicle_stays_grounded", "type": "transform_bounds", "target": "Chassis", "axis": "y", "min": 0.2 },
    { "id": "finite_transforms", "type": "no_nan_transforms" },
    { "id": "mobile_draw_budget", "type": "draw_call_budget", "max": 100 },
    { "id": "sim_performance", "type": "fps_min", "min": 30 }
  ]
}

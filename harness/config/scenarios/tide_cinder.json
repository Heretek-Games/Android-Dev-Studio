  "dialogues": {
    "DungeonKeeper": {
      "id": "DungeonKeeper",
      "title": "The Dungeon Keeper",
      "startNodeId": "greet",
      "nodes": {
        "greet": {
          "id": "greet",
          "type": "choice",
          "speaker": "Dungeon Keeper",
          "text": "A tyrant of cinder nests below. Take the Hydro blessing, or fight it bare-handed?",
          "choices": [
            {
              "id": "bless",
              "text": "Take the Hydro blessing",
              "nextNodeId": "blessed"
            },
            {
              "id": "refuse",
              "text": "Fight unaided",
              "nextNodeId": "refused"
            }
          ]
        },
        "blessed": {
          "id": "blessed",
          "type": "action",
          "speaker": "Dungeon Keeper",
          "text": "May the tide guide your blade.",
          "action": {
            "setVariables": {
              "hydroBlessing": true
            },
            "emitEvent": {
              "eventName": "hydro_blessing"
            },
            "nextNodeId": "farewell"
          }
        },
        "refused": {
          "id": "refused",
          "type": "text",
          "speaker": "Dungeon Keeper",
          "text": "Stubborn. The tyrant will enjoy that.",
          "nextNodeId": "farewell"
        },
        "farewell": {
          "id": "farewell",
          "type": "end",
          "speaker": "Dungeon Keeper",
          "text": "Clear the hall, slay the tyrant, and the gate opens."
        }
      }
    }
  },
